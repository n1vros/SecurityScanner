# STOscanner environment
#
# Copy to .env and fill in what you need:  cp .env.example .env
# Every option below maps to a field in app/core/config.py.
# Commented lines are optional. Secrets are commented out on purpose: set them in .env, never in git.

# ----------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# ----------------------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------------------
DB_USERNAME=postgres
# DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stoscanner
DB_ECHO=false
DB_POOL_DISABLE=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# ----------------------------------------------------------------------
# Rate limiting (per root domain)
# ----------------------------------------------------------------------
RATE_LIMIT_PER_DOMAIN=1.0
GLOBAL_CONCURRENCY_LIMIT=100
RATE_LIMIT_BUCKET_SIZE=5

# ----------------------------------------------------------------------
# CDN-aware rate limits (req/s; 0 = skip that CDN this cycle)
# ----------------------------------------------------------------------
AKAMAI_RATE_LIMIT=0.5
CLOUDFLARE_RATE_LIMIT=2.0
FASTLY_RATE_LIMIT=1.0
CLOUDFRONT_RATE_LIMIT=2.0
INCAPSULA_RATE_LIMIT=0.5
SUCURI_RATE_LIMIT=1.0

# ----------------------------------------------------------------------
# Scan cadence and discovery
# ----------------------------------------------------------------------
SCAN_INTERVAL_HOURS=24
RESCAN_STALE_HOURS=168
PASSIVE_DISCOVERY_ENABLED=true
ACTIVE_DISCOVERY_ENABLED=false
# ACTIVE_WORDLIST_PATH=
ACTIVE_DISCOVERY_CONCURRENCY=200
DNS_PROBE_TIMEOUT=5

# ----------------------------------------------------------------------
# DNS resolvers and health checks
# ----------------------------------------------------------------------
DNS_RESOLVERS=1.1.1.1,8.8.8.8
DNS_RESOLVER_URLS=
DNS_RESOLVER_FILES=
DNS_RESOLVER_CACHE=files/resolvers_cache.txt
DNS_RESOLVER_REFRESH_HOURS=48.0
DNS_HEALTH_SAMPLE_SIZE=200
DNS_HEALTH_MAX_PROBES=3
DNS_HEALTH_TIMEOUT=1.0
DNS_HEALTH_CONCURRENCY=2000
DNS_HEALTH_MIN_LIVE=50
PROGRAMS_LIMIT_PER_ITERATION=10
POTENTIAL_RECHECK_LIMIT=50

# ----------------------------------------------------------------------
# Takeover detection and verification
# ----------------------------------------------------------------------
POTENTIAL_RECHECK_HOURS=24
POTENTIAL_LONG_RECHECK_HOURS=72
TAKEOVER_PROVIDER_VERIFY_COOLDOWN_HOURS=24
TAKEOVER_CHECK_RATE_LIMIT=1.0
TAKEOVER_SIGNATURES_PATH=files/signatures.yaml
DNS_TAKEOVER_PROVIDERS_PATH=files/dns_takeover_providers.yaml

# ----------------------------------------------------------------------
# Automatic takeover policy
# ----------------------------------------------------------------------
# Master switch for provider *attempts* (resource creation / claim). Detection,
# verification-only checks and alerting still run when false; each provider is
# additionally gated by its own credentials.
TAKEOVER_AUTO_ENABLED=true
# Retry cadence after an automatic attempt:
#   FAIL / UNAVAILABLE / failed claim validation -> TAKEOVER_RETRY_HOURS
#   NEEDS_TXT / Heroku name_reserved / Netlify domain_claimed_elsewhere /
#   NOT_IMPL manual cases                        -> TAKEOVER_RETRY_DAYS
# A validated SUCCESS and NOT_VULN/TAKEN never retry automatically.
TAKEOVER_RETRY_HOURS=24
TAKEOVER_RETRY_DAYS=7
# A provider SUCCESS is only accepted as a takeover when the claimed hostname
# serves this marker (every auto-takeover provider deploys it via CLAIM_HTML).
TAKEOVER_CLAIM_MARKER=STO by Rizin
TAKEOVER_CLAIM_VALIDATE_TIMEOUT=15
TAKEOVER_CLAIM_VALIDATE_ATTEMPTS=3

NUCLEI_TEMPLATES_PATH=app/nuclei/templates
NUCLEI_BINARY=nuclei
NS_CONFIRMATION_ENABLED=true
NS_CONFIRMATION_RESOLVERS=1.1.1.1,1.0.0.1,8.8.8.8,8.8.4.4,9.9.9.9,149.112.112.112,208.67.222.222,208.67.220.220,64.6.64.6,64.6.65.6,185.228.168.9,185.228.169.9,94.140.14.14,94.140.15.15,76.76.19.19,76.223.122.150
NS_CONFIRMATION_MIN_AGREE=2
NS_CONFIRMATION_TIMEOUT=5.0

# ----------------------------------------------------------------------
# Discord notifications
# ----------------------------------------------------------------------
# DISCORD_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL_TEST=
NS_SWEEP_BATCH_SIZE=1000
NS_SWEEP_WARM_POOL_ENABLED=true
NS_SWEEP_WARM_POOL_SAMPLE=200
NS_SWEEP_WARM_POOL_MIN=8
NS_SWEEP_WARM_POOL_TIMEOUT=1.0
NS_SWEEP_WARM_POOL_CONCURRENCY=200
NS_SWEEP_WARM_POOL_ATTEMPTS=2
DNS_TAKEOVER_SWEEP_CONCURRENCY=10

# ----------------------------------------------------------------------
# NS / DNS sweep
# ----------------------------------------------------------------------
NS_SWEEP_ENABLED=false
NS_SWEEP_CONCURRENCY=10
NS_SWEEP_INTERVAL_HOURS=168
DANGLING_IP_CHECK_ENABLED=true
DANGLING_IP_CLOUD_CLAIM_CHECK=false
DANGLING_IP_CNAME_FOLLOW=true
DANGLING_IP_MX_CHECK=true
DANGLING_IP_HTTP_PROBE=true
DANGLING_IP_TLS_CHECK=true
DANGLING_IP_PTR_CHECK=true
DANGLING_IP_CONCURRENCY=30
DANGLING_IP_TIMEOUT=5.0
DANGLING_IP_PORTS=22,80,443,3389,8080,8443
DANGLING_SPF_DMARC_CHECK=true

# ----------------------------------------------------------------------
# Redis (provisioned by docker-compose; currently unused by code)
# ----------------------------------------------------------------------
# Used by docker-compose.yml only:
# REDIS_PASSWORD=
# REDIS_URL=

# ----------------------------------------------------------------------
# External tool locations
# ----------------------------------------------------------------------
SUBFINDER_BINARY=subfinder
HTTPX_BINARY=httpx

# ----------------------------------------------------------------------
# Platform API credentials
# ----------------------------------------------------------------------
# H1_USERNAME=
# H1_API_TOKEN=
# YWH_TOKEN=
# BC_SESSION=
# BC_CROWDCONTROL_SESSION=
# INTI_TOKEN=
# HP_CF_CLEARANCE=
# HP_REMEMBER_USER_TOKEN=

# ----------------------------------------------------------------------
# Automatic platform sync (daemon background loop)
# ----------------------------------------------------------------------
# Each platform is resynced when now - last successful/attempted sync is at
# least its interval. Credentials come from the platform API section above;
# a platform without credentials is skipped, never synced anonymously.
PLATFORM_SYNC_ENABLED=true
PLATFORM_SYNC_POLL_SECONDS=60
HACKERONE_SYNC_INTERVAL_DAYS=7
YESWEHACK_SYNC_INTERVAL_DAYS=7
INTIGRITI_SYNC_INTERVAL_DAYS=7
BUGCROWD_SYNC_INTERVAL_DAYS=7

# ----------------------------------------------------------------------
# puredns / permutation scanning
# ----------------------------------------------------------------------
PUREDNS_BINARY=puredns
PUREDNS_RATE_LIMIT=500
PUREDNS_TIMEOUT_SECS=300
PUREDNS_MAX_CONCURRENT=4
ALTERX_ENABLED=true
ALTERX_BINARY=alterx
ALTERX_MAX_CONCURRENT=3
ALTERX_TIMEOUT_SECS=120
ALTERX_ENRICH_ALL=false
SUBFINDER_MAX_CONCURRENT=3
SUBFINDER_TIMEOUT=120

# ----------------------------------------------------------------------
# JS scraping and JS secret scanning
# ----------------------------------------------------------------------
JSSCRAPE_ENABLED=false
JSSCRAPE_RESCAN_HOURS=336
JSSCRAPE_GAU_BINARY=gau
JSSCRAPE_WAYBACKURLS_BIN=waybackurls
JSSCRAPE_KATANA_BINARY=katana
JSSCRAPE_KATANA_DEPTH=2
JSSCRAPE_KATANA_PAGES=50
JSSCRAPE_FETCH_JITTER_MS=300
JSSCRAPE_FETCH_STAGGER_MS=200
JSSCRAPE_FETCH_CONCURRENCY=10
JSSCRAPE_FETCH_TIMEOUT=15
JSSCRAPE_TOOL_TIMEOUT=60
JSSCRAPE_MAX_JS_SIZE=524288
JSSCRAPE_MAX_URLS=500
# JS_SECRET_SCAN_ENABLED=false
# JS_SECRET_MAX_BODY_BYTES=524288
# JS_SECRET_MIN_MATCH_LEN=16
# JS_SECRET_TRUFFLEHOG=false
# JS_SECRET_TRUFFLEHOG_BIN=trufflehog
# JS_SECRET_TRUFFLEHOG_TIMEOUT=30

# ----------------------------------------------------------------------
# Git secret scanner (TruffleHog)
# ----------------------------------------------------------------------
GIT_SCANNER_ENABLED=false
GIT_SCANNER_INTERVAL_HOURS=24.0
GIT_SCANNER_CONCURRENCY=1
GIT_CLONE_TMP_DIR=/tmp/gitscan
GIT_CLONE_TIMEOUT=120
GIT_CLONE_DELAY=3.0
TRUFFLEHOG_BIN=trufflehog
TRUFFLEHOG_TIMEOUT=300
TRUFFLEHOG_ARCHIVE_MAX_SIZE=104857600
TRUFFLEHOG_ARCHIVE_MAX_DEPTH=1
# GITHUB_TOKEN=
# GITLAB_TOKEN=

# ----------------------------------------------------------------------
# Exposed-file scanner
# ----------------------------------------------------------------------
EXPOSURE_SCAN_ENABLED=false
EXPOSURE_SCAN_TIMEOUT=5
EXPOSURE_SCAN_CONCURRENCY=3
EXPOSURE_WORDLIST_PATH=exposure_paths.yaml
EXPOSURE_RENOTIFY_DAYS=30
EXPOSURE_BATCH_SIZE=100
EXPOSURE_FINDINGS_PATH=/findings

# ----------------------------------------------------------------------
# Domain expiry / availability scanner
# ----------------------------------------------------------------------
DOMAIN_BUY_SCANNER_ENABLED=true
DOMAIN_BUY_RENOTIFY_HOURS=48
DOMAIN_BUY_WHOIS_MIN_INTERVAL_SECONDS=2.0
DOMAIN_BUY_WHOIS_RATE_LIMIT_BACKOFF_SECONDS=15.0
DOMAIN_BUY_WHOIS_RETRY_LIMIT=5

# ----------------------------------------------------------------------
# Network
# ----------------------------------------------------------------------
# HTTP_PROXY=

# ----------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
# LOG_FILE=
ACTIVE_TASKS_TIMEOUT_SECONDS=300
SCOPE_CONCURRENCY=5
SUBDOMAINS_LIMIT_PER_SCOPE=1000

# ----------------------------------------------------------------------
# Daemon loop
# ----------------------------------------------------------------------
# Start the scanner daemon automatically when the web app starts (default off).
DAEMON_AUTOSTART=false
DAEMON_SLEEP_SECONDS=60
# DAEMON_MAX_ITERATIONS=

# ----------------------------------------------------------------------
# Cloud takeover providers
# ----------------------------------------------------------------------
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
# HEROKU_API_KEY=
# NETLIFY_TOKEN=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_SUBSCRIPTION_ID=
# AZURE_RESOURCE_GROUP=
AZURE_LOCATION=eastus
# POC_IP=
POC_TXT="Bugbounty - DNS takeover POC by Rizin"
POC_TTL=60

# ----------------------------------------------------------------------
# NS lottery takeovers
# ----------------------------------------------------------------------
ROUTE53_TAKEOVER_ENABLED=true
ROUTE53_MAX_ATTEMPTS=200
ROUTE53_SLEEP_BETWEEN=1.0
AZURE_DNS_TAKEOVER_ENABLED=true
AZURE_DNS_NUM_GROUPS=20
AZURE_DNS_LOCATION=eastus
DNS_TAKEOVER_ENABLED=true
DNS_TAKEOVER_TIMEOUT=3
DNS_TAKEOVER_RENOTIFY_HOURS=24
CERTSTREAM_TAKEOVER_CHECK_ENABLED=true

# ----------------------------------------------------------------------
# Certificate Transparency monitoring
# ----------------------------------------------------------------------
CERTSTREAM_ENABLED=true
CERTSTREAM_URL=wss://certstream.calidog.io
CERTSTREAM_SCOPE_REFRESH_SECS=300
CERTSTREAM_RECONNECT_SECS=5
CERTSTREAM_SKIP_WILDCARDS=true
WAYBACK_GAU_BINARY=gau
WAYBACK_WAYBACKURLS_BIN=waybackurls

# ----------------------------------------------------------------------
# Wayback discovery
# ----------------------------------------------------------------------
WAYBACK_ENABLED=true
WAYBACK_TOOL_TIMEOUT=90
WAYBACK_MAX_URLS=50000
EXPOSURE_RATE_LIMIT=10
IP_HUNTER_MODE=off

# ----------------------------------------------------------------------
# IP hunter
# ----------------------------------------------------------------------
IP_HUNTER_ENABLED=false
IP_HUNTER_INTERVAL_HOURS=6
IP_HUNTER_ATTEMPTS_PER_BLOCK=50
IP_HUNTER_TOP_BLOCKS=20
IP_HUNTER_MIN_FREE_RATIO=0.3
IP_HUNTER_MIN_DENSITY=2
CIDR_INDEX_CACHE_PATH=files/cidr_cache
CIDR_INDEX_MAX_AGE_HOURS=24

# ----------------------------------------------------------------------
# AWS Elastic IP hunter
# ----------------------------------------------------------------------
AWS_EIP_REGIONS=us-east-1,us-west-2,eu-west-1,ap-southeast-1
AWS_EIP_SLEEP_MS=200
AWS_EIP_DUP_HOLD=4

# ----------------------------------------------------------------------
# DigitalOcean reserved IP hunter
# ----------------------------------------------------------------------
# DO_API_TOKEN=
DO_EIP_REGIONS=nyc1,nyc3,sfo3,ams3,sgp1,lon1,fra1,blr1,tor1,syd1
DO_EIP_ATTEMPTS=50
DO_EIP_SLEEP_MS=500
DO_EIP_BATCH_SIZE=5

# ----------------------------------------------------------------------
# GCP static IP hunter
# ----------------------------------------------------------------------
# GCP_PROJECT_ID=
# GCP_SERVICE_ACCOUNT_JSON=
# GCP_SERVICE_ACCOUNT_KEY=
GCP_EIP_REGIONS=us-central1,us-east1,europe-west1,asia-southeast1
GCP_EIP_ATTEMPTS=20
GCP_EIP_SLEEP_MS=1000
GCP_EIP_BATCH_SIZE=3

# ----------------------------------------------------------------------
# Azure public IP hunter
# ----------------------------------------------------------------------
AZURE_PIP_REGIONS=eastus,westus2,westeurope,southeastasia
AZURE_PIP_ATTEMPTS=20
AZURE_PIP_SLEEP_MS=1000

# ----------------------------------------------------------------------
# IP liveness checks
# ----------------------------------------------------------------------
IP_CHECK_ENABLED=true
IP_CHECK_PORTS=22,80,443,3389,8080,8443
IP_CHECK_TIMEOUT=5.0
IP_CHECK_CONCURRENCY=20
IP_HUNTER_CONFIRM_PORTS=
IP_HUNTER_CONFIRM_TIMEOUT=2.0
IP_HUNTER_CONFIRM_CONCURRENCY=50
IP_HUNTER_CONFIRM_HTTP=true
IP_HUNTER_CONFIRM_PTR=true
IP_HUNTER_INFORM_CONCURRENCY=20
IP_HUNTER_ASN_LOOKUP=false
AWS_EIP_ENABLED=true
GCP_EIP_ENABLED=true
AZURE_PIP_ENABLED=true
DO_EIP_ENABLED=true
VULNERABLE_IP_PROVIDERS_PATH=files/vulnerable_ip_providers.yaml
