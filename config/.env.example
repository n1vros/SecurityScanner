# STOscanner Configuration
# Copy this file to .env in the project root and adjust values

PORT=8000
HOST=127.0.0.1
# Database Configuration
# DATABASE_URL is generated from components below - do not set directly
DB_USERNAME=user
DB_PASSWORD=passwd
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stoscanner
DB_ECHO=false
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# Optional: Redis for distributed rate limiting
REDIS_URL=redis://localhost:6379/0

# Rate Limiting
RATE_LIMIT_PER_DOMAIN=3.0  # requests per second per domain
GLOBAL_CONCURRENCY_LIMIT=10 #At most x subdomains probed at once, regardless of domain
RATE_LIMIT_BUCKET_SIZE=2 #strictly paced, never hits a domain faster than x req/sec even after idle period

SUBFINDER_MAX_CONCURRENT=3
SUBFINDER_TIMEOUT=120

AMASS_MAX_CONCURRENT=3
AMASS_DNS_QPS=25
AMASS_TIMEOUT_MINS=30

PROGRAMS_LIMIT_PER_ITERATION=50

# Scanning Configuration
SCAN_INTERVAL_HOURS=24
RESCAN_STALE_HOURS=168  # 1 week
PASSIVE_DISCOVERY_ENABLED=true
ACTIVE_DISCOVERY_ENABLED=false
ACTIVE_WORDLIST_PATH=wordlists/subdomains.txt
DNS_RESOLVERS=1.1.1.1,1.0.0.1,8.8.8.8,8.8.4.4,9.9.9.9,149.112.112.112,208.67.222.222,208.67.220.220,94.140.14.14,94.140.15.15

# Takeover Detection
CONFIDENCE_THRESHOLD=69
POTENTIAL_RECHECK_HOURS=24
POTENTIAL_LONG_RECHECK_HOURS=72
TAKEOVER_PROVIDER_VERIFY_COOLDOWN_HOURS=24
TAKEOVER_CHECK_RATE_LIMIT=1.0
TAKEOVER_SIGNATURES_PATH=app/takeover/signatures.yaml

# Notifications
DISCORD_WEBHOOK_URL=WEBHOOK
NOTIFY_ON_CONFIDENCE_ABOVE=69

# Domain buy scanner
DOMAIN_BUY_SCANNER_ENABLED=true
DOMAIN_BUY_RENOTIFY_HOURS=48
DOMAIN_BUY_WHOIS_MIN_INTERVAL_SECONDS=2.0
DOMAIN_BUY_WHOIS_RATE_LIMIT_BACKOFF_SECONDS=15.0
DOMAIN_BUY_WHOIS_RETRY_LIMIT=5

# External Tools (install separately)
SUBFINDER_BINARY=subfinder
AMASS_BINARY=amass
HTTPX_BINARY=httpx
GIT_SCANNER_ENABLED=false
GIT_SCANNER_INTERVAL_HOURS=24

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=
#LOG_FILE=/var/log/stoscanner.log

# Daemon Settings
DAEMON_SLEEP_SECONDS=69
DAEMON_MAX_ITERATIONS=

# HackerOne API Credentials
H1_USERNAME=USERNAME
H1_API_TOKEN=TOKEN

#Takeover providers
VERCEL_TOKEN=your_vercel_api_token_here
